include(FindPackageHandleStandardArgs)

set(_AOCL_PREFIXES)
foreach(_root AOCL_ROOT AOCL_UTILS_ROOT AOCL_BLIS_ROOT AOCL_FLAME_ROOT)
  if(${_root})
    list(APPEND _AOCL_PREFIXES "${${_root}}")
  endif()
endforeach()

set(_AOCL_UTILS_HINTS)
set(_AOCL_BLIS_HINTS)
set(_AOCL_FLAME_HINTS)
foreach(_prefix IN LISTS _AOCL_PREFIXES)
  list(APPEND _AOCL_UTILS_HINTS "${_prefix}/lib" "${_prefix}/lib64")
  list(APPEND _AOCL_BLIS_HINTS "${_prefix}/lib" "${_prefix}/lib64")
  list(APPEND _AOCL_FLAME_HINTS "${_prefix}/lib" "${_prefix}/lib64")
endforeach()

find_path(AOCL_UTILS_INCLUDE_DIR
  NAMES Au/Au.hh alci/alci.h
  HINTS "${AOCL_UTILS_ROOT}/include" ${_AOCL_PREFIXES}
  PATH_SUFFIXES include)
find_library(AOCL_UTILS_LIBRARY
  NAMES aoclutils
  HINTS "${AOCL_UTILS_ROOT}/lib" "${AOCL_UTILS_ROOT}/lib64" ${_AOCL_UTILS_HINTS})

find_path(AOCL_BLIS_INCLUDE_DIR
  NAMES blis/blis.h blis.h
  HINTS "${AOCL_BLIS_ROOT}/include" ${_AOCL_PREFIXES}
  PATH_SUFFIXES include)
find_library(AOCL_BLIS_LIBRARY
  NAMES blis-mt
  HINTS "${AOCL_BLIS_ROOT}/lib" "${AOCL_BLIS_ROOT}/lib64" ${_AOCL_BLIS_HINTS})

find_path(AOCL_FLAME_INCLUDE_DIR
  NAMES lapacke.h FLAME.h
  HINTS "${AOCL_FLAME_ROOT}/include" ${_AOCL_PREFIXES}
  PATH_SUFFIXES include)
find_library(AOCL_FLAME_LIBRARY
  NAMES flame
  HINTS "${AOCL_FLAME_ROOT}/lib" "${AOCL_FLAME_ROOT}/lib64" ${_AOCL_FLAME_HINTS})

if(AOCL_UTILS_LIBRARY AND NOT TARGET AOCL::Utils)
  add_library(AOCL::Utils UNKNOWN IMPORTED)
  set_target_properties(AOCL::Utils PROPERTIES
    IMPORTED_LOCATION "${AOCL_UTILS_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${AOCL_UTILS_INCLUDE_DIR}")
endif()

if(AOCL_BLIS_LIBRARY AND NOT TARGET AOCL::BLIS)
  add_library(AOCL::BLIS UNKNOWN IMPORTED)
  set_target_properties(AOCL::BLIS PROPERTIES
    IMPORTED_LOCATION "${AOCL_BLIS_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${AOCL_BLIS_INCLUDE_DIR}")
endif()

if(AOCL_FLAME_LIBRARY AND NOT TARGET AOCL::FLAME)
  add_library(AOCL::FLAME UNKNOWN IMPORTED)
  set_target_properties(AOCL::FLAME PROPERTIES
    IMPORTED_LOCATION "${AOCL_FLAME_LIBRARY}"
    INTERFACE_INCLUDE_DIRECTORIES "${AOCL_FLAME_INCLUDE_DIR}"
    INTERFACE_LINK_LIBRARIES "AOCL::BLIS;AOCL::Utils;OpenMP::OpenMP_CXX;${CMAKE_DL_LIBS}")
endif()

find_package_handle_standard_args(AOCL
  REQUIRED_VARS
    AOCL_UTILS_LIBRARY
    AOCL_UTILS_INCLUDE_DIR
    AOCL_BLIS_LIBRARY
    AOCL_BLIS_INCLUDE_DIR
    AOCL_FLAME_LIBRARY
    AOCL_FLAME_INCLUDE_DIR)

mark_as_advanced(
  AOCL_UTILS_INCLUDE_DIR AOCL_UTILS_LIBRARY
  AOCL_BLIS_INCLUDE_DIR AOCL_BLIS_LIBRARY
  AOCL_FLAME_INCLUDE_DIR AOCL_FLAME_LIBRARY)
